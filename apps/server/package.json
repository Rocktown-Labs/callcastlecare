{
  "name": "server",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "build": "tsdown",
    "check-types": "tsc -b",
    "compile": "bun build --compile --minify --sourcemap --bytecode ./src/node-server.ts --outfile server",
    "dev": "tsx watch src/dev-server.ts",
    "reset-legacy-provider-passwords": "tsx scripts/reset-legacy-provider-passwords.ts",
    "start": "node dist/node-server.mjs",
    "test": "vitest run"
  },
  "dependencies": {
    "@callcastlecare/api": "workspace:*",
    "@callcastlecare/auth": "workspace:*",
    "@callcastlecare/db": "workspace:*",
    "@callcastlecare/email": "workspace:*",
    "@callcastlecare/env": "workspace:*",
    "@hono/node-server": "^2.0.8",
    "@hono/zod-openapi": "^1.5.1",
    "better-auth": "catalog:",
    "dotenv": "catalog:",
    "evlog": "catalog:",
    "hono": "^4.12.27",
    "pino": "^10.3.1",
    "resend": "^6.9.3",
    "stoker": "^2.0.1",
    "stripe": "^22.3.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@callcastlecare/config": "workspace:*",
    "@cloudflare/workers-types": "^4.20241022.0",
    "@types/node": "^22.13.14",
    "tsdown": "^0.22.3",
    "tsx": "catalog:",
    "typescript": "^6"
  }
}
